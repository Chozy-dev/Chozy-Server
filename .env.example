# Documentation only: Spring Boot does not automatically load .env.
SPRING_PROFILES_ACTIVE=dev
# Isolated PostgreSQL compose/dbdev only. Set a unique local secret; never reuse Collector credentials.
# CHOZY_DEV_DB_PASSWORD=<local-development-secret>
# Development safety guard accepts only these canonical target values.
# CHOZY_DEV_DB_NAME=chozy_spring_dev
# CHOZY_DEV_DB_USERNAME=chozy_spring_dev
# CHOZY_DEV_DB_URL=jdbc:postgresql://127.0.0.1:55432/chozy_spring_dev
SERVER_PORT=8080
# Comma-separated exact frontend origins. Empty means no cross-origin access.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Only set for an explicitly reviewed database/prod profile; no production credentials.
# CHOZY_DB_URL=jdbc:postgresql://<reviewed-host>:5432/<reviewed-database>
# CHOZY_DB_USERNAME=<dedicated-spring-login>
# CHOZY_DB_PASSWORD=<local-secret>
OPENAPI_ENABLED=false
OPENAPI_PUBLIC=false
# Required for dbdev/database/prod: Base64-encoded CSPRNG key, at least 32 bytes. No default.
# JWT_SECRET_BASE64=<inject-from-secret-store>
JWT_ACCESS_SECONDS=3600
JWT_REFRESH_SECONDS=1209600
# Unverified signup: dbdev only by default; prod always rejects it.
# APP_AUTH_UNVERIFIED_SIGNUP_ENABLED=false
# Home recommendations. Use a Collector login with permission to execute public.read_supply_home(text, integer).
# APP_HOME_RECOMMENDATIONS_ENABLED=true
# CHOZY_RECOMMENDATIONS_DB_URL=jdbc:postgresql://<reviewed-host>:5432/<collector-database>
# CHOZY_RECOMMENDATIONS_DB_USERNAME=<dedicated-spring-runtime-login>
# CHOZY_RECOMMENDATIONS_DB_PASSWORD=<inject-from-secret-store>
# Home Coupang best, Naver season keywords, and comparison. Use a read-only Collector login.
# APP_HOME_MARKET_PUBLICATIONS_ENABLED=true
# CHOZY_HOME_MARKET_DB_URL=jdbc:postgresql://<reviewed-host>:5432/<collector-database>
# CHOZY_HOME_MARKET_DB_USERNAME=<dedicated-market-publications-reader>
# CHOZY_HOME_MARKET_DB_PASSWORD=<inject-from-secret-store>
# Manual analysis external APIs (disabled by default). Use reviewed accounts sharing the Collector budget.
# APP_ANALYSIS_MARKET_ENABLED=true
# CHOZY_MARKET_BUDGET_DB_URL=jdbc:postgresql://<reviewed-host>:5432/<collector-budget-database>
# CHOZY_MARKET_BUDGET_DB_USERNAME=<dedicated-spring-runtime-login>
# CHOZY_MARKET_BUDGET_DB_PASSWORD=<inject-from-secret-store>
# CHOZY_MARKET_COUPANG_ACCOUNT=<collector-budget-account>
# CHOZY_MARKET_NAVER_ACCOUNT=<collector-budget-account>
# COUPANG_ACCESS_KEY=<inject-from-secret-store>
# COUPANG_SECRET_KEY=<inject-from-secret-store>
# NAVER_AD_API_KEY=<inject-from-secret-store>
# NAVER_AD_SECRET_KEY=<inject-from-secret-store>
# NAVER_AD_CUSTOMER_ID=<search-ad-customer-id>
# NAVER_HUB_KEY_ID=<inject-from-secret-store>
# NAVER_HUB_KEY=<inject-from-secret-store>
